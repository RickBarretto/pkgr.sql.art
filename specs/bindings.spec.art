import {unitt}!
import {src/lib.art}!

describe "Scoped SQLite parameter adapters" [
    it "preserves numeric expressions, aggregate filters and SQL nulls" [
        db: open.sqlite ":memory:"
        failure: try [
            ignored: sqliteExecute db sql [create :books [
                column id :integer
                column pages :integer
                column.optional subtitle :string
            ]]
            ignored: sqliteExecute db sql [insert :books [
                columns [id pages subtitle]
                row [1 0 null]
                row [2 100 "null"]
                row [3 200 "River"]
            ]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [pages + 1 >= 101] order id] [["2"] ["3"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [5 < pages - 1] order id] [["2"] ["3"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [nullif pages 0 is null]] [["1"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [coalesce [subtitle "Fallback"] = "Fallback"]] [["1"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [subtitle = "null"]] [["2"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [pages + 1 in [101 201]] order id] [["2"] ["3"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [pages + 1 between [100 200]]] [["2"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select count "*" having [[count "*"] > 2]] [["3"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [coalesce [null 1.5] > 1.0] order id limit 1] [["1"]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [choose [when [id = 1] true otherwise false] = true]] [["1"]]]
            ignored: sqliteExecute db sql [update :books [assign subtitle null where [id = 3]]]
            expects.be: 'equal? @[sqliteExecute db sql [from :books select id where [subtitle is null] order id] [["1"] ["3"]]]
        ]
        close db
        unless null? failure -> throw to :string failure
    ]

    it "preserves original native functions after compilation, execution and errors" [
        names: [query select remove when sum min max join]
        originals: map names 'name -> var name
        ignored: to :sqliteQuery sql [from :books select nullif pages 0 where [pages + 1 > 2]]
        db: open.sqlite ":memory:"
        failure: try [
            ignored: sqliteExecute db sql [create :books -> column id :integer]
            ignored: sqliteExecute db sql [insert :books [columns id row [1]]]
            ignored: sqliteExecute db sql [from :books select id where [id + 1 = 2]]
            conversionError: try [ignored: to :sqliteQuery sql [from :books select id where [id > all query [from :books select id]]]]
            expects.be: 'equal? @[type conversionError :error]
            executionError: try [ignored: sqliteExecute db sql [from :missing select id]]
            expects.be: 'equal? @[type executionError :error]
            expects.be: 'equal? @[query db "SELECT 1" [["1"]]]
        ]
        close db
        unless null? failure -> throw to :string failure
        restored: map names 'name -> var name
        expects.be: 'equal? @[originals restored]
        expects.be: 'equal? @[key? symbols '_sqliteScalar false]
        expects.be: 'equal? @[key? symbols '_sqliteComparable false]
        expects.be: 'equal? @[select [1 2 3] 'number -> number > 1 [2 3]]
    ]
]
