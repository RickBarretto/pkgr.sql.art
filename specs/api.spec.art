import {unitt}!
import {src/lib.art}!

describe "Function API" [
    it "captures identifiers and appends projections, filters and sort keys in any order" [
        books: "unrelated"
        compiled: to :sqliteQuery sql [
            where -> and publishedYear >= 2020 available = true
            order.desc 'publishedYear
            from :books
            select.as: 'name 'title
            select 'id
            order 'id
            limit.skip: 2 5
        ]
        expects.be: 'equal? @[compiled\params [2020 1 5 2]]
        expects.be: 'equal? @[contains? compiled\text {"title" AS "name"} true]
        expects.be: 'equal? @[contains? compiled\text {"publishedYear" DESC,} true]
        expects.be: 'equal? @[contains? compiled\text {"books"} true]
    ]

    it "captures host computations once even during arrow lookahead" [
        counter: #[calls: 0]
        nextValue: $[] [counter\calls: counter\calls + 1 counter\calls]
        captured: @[sql [from :books select id where -> id > (nextValue)]]
        expects.be: 'equal? @[size captured 1]
        expects.be: 'equal? @[counter\calls 1]
        statement: first captured
        compiled: to :sqliteQuery statement
        expects.be: 'equal? @[compiled\params [1]]
        ignored: to :sqliteQuery statement
        expects.be: 'equal? @[counter\calls 1]
    ]

    it "uses fixed arity for arrow predicates" [
        compiled: to :sqliteQuery sql [
            from :books
            where -> or title = "A" title = "B"
            select title
            where -> not [available = false]
        ]
        expects.be: 'equal? @[compiled\params ["A" "B" 0]]
        expects.be: 'equal? @[contains? compiled\text {NOT ("available" = ?)} true]
    ]

    it "binds IN, BETWEEN and LIKE values and normalizes less or equal" [
        compiled: to :sqliteQuery sql [
            from :books select title
            where [genre in ["Poetry" "History"]]
            where [publishedYear between [2015 2020]]
            where [title like "River%"]
            where [pageCount =< 400]
        ]
        expects.be: 'equal? @[compiled\params ["Poetry" "History" 2015 2020 "River%" 400]]
        expects.be: 'equal? @[contains? compiled\text {"pageCount" <= ?} true]
    ]

    it "composes aggregates, conditional expressions and grouping" [
        compiled: to :sqliteQuery sql [
            from :books select genre
            select.count.as: 'total "*"
            select avg pageCount
            select coalesce [subtitle title]
            select nullif pageCount 0
            select.as: 'length choose.default: "Short" [when [pageCount > 400] "Long"]
            group genre having [[count "*"] > 3]
        ]
        expects.be: 'equal? @[compiled\params [0 400 "Long" "Short" 3]]
        expects.be: 'equal? @[contains? compiled\text {COUNT(*) AS "total"} true]
        expects.be: 'equal? @[contains? compiled\text {GROUP BY
    "genre"
HAVING
    COUNT(*) > CAST(? AS INTEGER)} true]
    ]

    it "compiles CTE and nested query parameters in textual order" [
        constructed: @[sql [
            with :recent [from :books select id where [publishedYear > 2020]]
            from :recent select id
            where [id > query [from :books select.min id where [available = true]]]
            where [exists query [from :books select [id title] where [id > 3]]]
        ]]
        expects.be: 'equal? @[size constructed 1]
        statement: first constructed
        snapshot: new statement
        compiled: to :sqliteQuery statement
        expects.be: 'equal? @[compiled\params [2020 1 3]]
        expects.be: 'equal? @[statement snapshot]
        expects.be: 'equal? @[compiled to :sqliteQuery statement]
    ]

    it "keeps DSL helpers local and native functions intact" [
        before: symbols
        ignored: sql [from :books select count "*"]
        expects.be: 'equal? @[select [1 2 3] 'n -> n > 1 [2 3]]
        expects.be: 'equal? @[contains? symbols 'column contains? before 'column]
    ]

    it "rejects malformed contracts and owner context violations" [
        loop [
            [from :books select []]
            [from :books from :loans select title]
            [from :books select.count.sum title]
            [from :books select.count: true title]
            [from :books select.sum "*"]
            [from :books select.as: [a b] title]
            [from :books select title order.asc.desc title]
            [from :books select title where [id in []]]
            [from :books select title where [id between [1]]]
            [from :books select title where [id > query [from :books select [id title]]]]
            [create :books [select title]]
            [create :books [column.primary.optional id :integer]]
            [insert :books [row [1]]]
            [insert :books [columns [id title] row [1]]]
            [update :books []]
            [delete :books [assign id 1]]
            [combine.union [sql [from :books select title]]]
            [combine.union [sql [from :books select title] sql [from :books select [id title]]]]
            [from :books select title limit.skip: 1 2 offset 1]
        ] '_apiInput [
            failure: try [ignored: sql _apiInput]
            expects.be: 'equal? @[type failure :error]
        ]
    ]

    it "reports unsupported SQLite features explicitly" [
        loop [
            [from :books select genre group.rollup genre]
            [from :books select genre group.cube genre]
            [from :books select genre group.sets [[genre] []]]
            [from :books select title where [id > all query [from :books select id]]]
            [from :books select title where [id > any query [from :books select id]]]
            [create :books [column.identity id :integer]]
            [truncate :books]
        ] '_apiInput [
            statement: sql _apiInput
            failure: try [ignored: to :sqliteQuery statement]
            expects.be: 'equal? @[type failure :error]
        ]
    ]
]

describe "Function API contract boundaries" [
    it "accepts single command arrow bodies for writes and conditions" [
        inserted: to :sqliteQuery sql [insert.columns: [title] :books -> row ["River Atlas"]]
        updated: to :sqliteQuery sql [update :books -> assign title "Quiet Maps"]
        removed: to :sqliteQuery sql [delete :books -> where -> id = 1]
        chosen: to :sqliteQuery sql [from :books select choose -> when [id = 1] "First"]
        expects.be: 'equal? @[inserted\params ["River Atlas"]]
        expects.be: 'equal? @[updated\params ["Quiet Maps"]]
        expects.be: 'equal? @[removed\params [1]]
        expects.be: 'equal? @[chosen\params [1 "First"]]
    ]

    it "binds null in helpers, conditional branches and computed assignments" [
        statement: sql [
            from :books
            select coalesce [null title]
            select nullif title null
            select.nullif [title null]
            select choose [when [id = 1] null otherwise "Other"]
        ]
        compiled: to :sqliteQuery statement
        expects.be: 'equal? @[compiled\params @[null null null 1 null "Other"]]
        writeStatement: sql [update :books -> assign subtitle (null)]
        writeQuery: to :sqliteQuery writeStatement
        expects.be: 'equal? @[writeQuery\params @[null]]
    ]

    it "permits compatible numeric CASE results" [
        compiled: to :sqliteQuery sql [from :books select choose [
            when [id = 1] 1
            when [id = 2] 2.5
            otherwise null
        ]]
        expects.be: 'equal? @[compiled\params @[1 1 2 2.5 null]]
    ]

    it "constructs independent trigger writes without copying their enclosing builder" [
        statement: sql [create.trigger.after.insert.on: :loans :loanAdded [
            update :books -> assign available false
            update :books -> assign subtitle null
            delete :archivedBooks -> where -> id = new\bookId
        ]]
        snapshot: new statement
        writes: statement\details\statements
        expects.be: 'equal? @[size writes 3]
        loop writes 'writeStatement [
            expects.be: 'equal? @[key? writeStatement\details 'statements false]
            expects.be: 'equal? @[size writeStatement\details\options 0]
        ]
        compiled: to :sqliteQuery statement
        expects.be: 'equal? @[compiled\params []]
        expects.be: 'equal? @[contains? compiled\text {"subtitle" = NULL} true]
        expects.be: 'equal? @[statement snapshot]
        expects.be: 'equal? @[compiled to :sqliteQuery statement]
    ]

    it "rejects malformed nested builders, branch types and quantified operands" [
        loop [
            [where [id = 1] drop :books]
            [where [id = 1] update :books -> assign title "A"]
            [limit 2 delete :books []]
            [with :b [from :books select id] drop :books]
            [create.view :bookView [delete :books []]]
            [with :removed [delete :books []] from :books select title]
            [with :b [from :books select id] with :b [from :books select id] from :b select id]
            [create.trigger.after.before.insert.on: :books :changed [delete :books []]]
            [create.trigger.after.insert.update.on: :books :changed [delete :books []]]
            [create.trigger.after.insert :changed [delete :books []]]
            [create.trigger.after.insert.on: :books :changed []]
            [from :books select choose [when [id = 1] "First" otherwise 2]]
            [from :books select choose [otherwise "First" when [id = 1] "Other"]]
            [from :books select title where [id > all 1]]
            [from :books select title where [id > any title]]
            [from :books select title where [id = (null)]]
            [from :books select title group.sets []]
            [from :books select title group.sets [genre]]
        ] '_boundaryInput [
            failure: try [ignored: sql _boundaryInput]
            expects.be: 'equal? @[type failure :error]
        ]
    ]
]
