import {unitt}!
import {src/lib.art}!

describe "Terminal query tables" [
    it "renders dictionaries, compiled queries, wildcard columns and empty results" [
        db: open.sqlite ":memory:"
        failure: try [
            query db "CREATE TABLE users (id INTEGER, name TEXT)"
            query db {INSERT INTO users VALUES (1, 'Ada')}
            statement: sql [select [*] from users]
            expected: join.with:"\n" [
                "+----+------+"
                "| ID | Name |"
                "+----+------+"
                "| 1  | Ada  |"
                "+----+------+"
                ""
            ]
            expects.be: 'equal? @[sqliteTable.header: ["ID" "Name"] db statement expected]
            expects.be: 'equal? @[sqliteTable.header: ["ID" "Name"] db to :sqliteQuery statement expected]
            expects.be: 'equal? @[sqliteTable db statement tabular [["1" "Ada"]]]
            expects.be: 'equal? @[sqliteTable db sql [select [id] from users where [id = 2]] "No rows."]
            invalidHeader: try [ignored: sqliteTable.header: ["ID"] db statement]
            expects.be: 'equal? @[type invalidHeader :error]
            expects.be: 'equal? @[query db "SELECT 1" [["1"]]]
        ]
        close db
        unless null? failure [throw to :string failure]
    ]
]

describe "SQL builder" [
    it "compiles dynamic predicates and pagination" [
        minimumAge: 18
        statement: sql [
            select [id name]
            from users
            where [age >= (minimumAge) and active = true]
            orderBy [name asc]
            limit 20
        ]
        compiled: to :sqliteQuery statement
        expects.be: 'equal? @[compiled\params [18 1 20]]
        expected: join.with:"\n" [
            "SELECT"
            "    \"id\","
            "    \"name\""
            "FROM"
            "    \"users\""
            "WHERE"
            "    (\"age\" >= ? AND \"active\" = ?)"
            "ORDER BY"
            "    \"name\" ASC"
            "LIMIT"
            "    ?"
        ]
        expects.be: 'equal? @[compiled\text expected]
        expects.be: 'equal? @[compiled to :sqliteQuery statement]
    ]

    it "preserves nested groups and null tests" [
        compiled: to :sqliteQuery sql [
            select [*]
            from users
            where [age > 10 and [active = true or role = "admin"]]
            where [email is not null]
        ]
        expects.be: 'equal? @[compiled\params @[10 1 "admin"]]
        expected: join.with:"\n" [
            "SELECT"
            "    *"
            "FROM"
            "    \"users\""
            "WHERE"
            "    (\"age\" > ? AND (\"active\" = ? OR \"role\" = ?))"
            "    AND \"email\" IS NOT NULL"
        ]
        expects.be: 'equal? @[compiled\text expected]
    ]
]

describe "SQL validation and execution" [
    it "rejects malformed queries" [
        loop [
            [select [] from users]
            [select [id] from users where []]
            [select [id] from users where [id = null]]
            [select [id] from users limit -1]
            [select [id] from users offset 1]
            [select [id] from users limit 1 limit 2]
            [select [id] from users where [id = 1 and]]
        ] 'input [
            failure: try [ignored: sql input]
            expects.be: 'equal? @[type failure :error]
        ]
    ]

    it "executes parameterized SQLite queries" [
        db: open ":memory:"
        query db {CREATE TABLE users (id INTEGER, age INTEGER, active INTEGER)}
        query db {INSERT INTO users VALUES (1, 20, 1), (2, 12, 1), (3, 30, 0)}
        compiled: to :sqliteQuery sql [
            select [id]
            from users
            where [age >= 18 and active = 1]
        ]
        rows: query.with: compiled\params db compiled\text
        expects.be: 'equal? @[size rows 1]
        close db
    ]

    it "resolves function-local values and normalizes inequality" [
        build: $[threshold] -> sql [
            select [*]
            from users
            where [age != (threshold)]
            limit 0
            offset 0
        ]
        compiled: to :sqliteQuery build 21
        expects.be: 'equal? @[compiled\params [21 0 0]]
        expected: join.with:"\n" [
            "SELECT"
            "    *"
            "FROM"
            "    \"users\""
            "WHERE"
            "    \"age\" <> ?"
            "LIMIT"
            "    ?"
            "OFFSET"
            "    ?"
        ]
        expects.be: 'equal? @[compiled\text expected]
    ]
]

describe "SQLite query conversion" [
    it "converts a minimal query to the SQLite type" [
        compiled: to :sqliteQuery sql [
            select [*]
            from users
        ]
        expects.be: 'equal? @[type compiled :sqliteQuery]
        expected: join.with:"\n" [
            "SELECT"
            "    *"
            "FROM"
            "    \"users\""
        ]
        expects.be: 'equal? @[compiled\text expected]
        expects.be: 'equal? @[compiled\params []]
    ]

    it "preserves AND precedence and defaults ordering to ascending" [
        compiled: to :sqliteQuery sql [
            select [id]
            from users
            where [id = 1 or age > 18 and active = false]
            orderBy [name id desc]
        ]
        expected: join.with:"\n" [
            "SELECT"
            "    \"id\""
            "FROM"
            "    \"users\""
            "WHERE"
            "    (\"id\" = ? OR (\"age\" > ? AND \"active\" = ?))"
            "ORDER BY"
            "    \"name\" ASC,"
            "    \"id\" DESC"
        ]
        expects.be: 'equal? @[compiled\text expected]
        expects.be: 'equal? @[compiled\params [1 18 0]]
    ]

    it "keeps SQL-looking strings in parameters" [
        compiled: to :sqliteQuery sql [
            select [id]
            from users
            where [name = {x' OR 1=1 --}]
        ]
        expected: join.with:"\n" [
            "SELECT"
            "    \"id\""
            "FROM"
            "    \"users\""
            "WHERE"
            "    \"name\" = ?"
        ]
        expects.be: 'equal? @[compiled\text expected]
        expects.be: 'equal? @[compiled\params [{x' OR 1=1 --}]]
    ]

    it "preserves the query dictionary and captured values across conversions" [
        threshold: 18
        statement: sql [
            select [id]
            from users
            where [age >= (threshold)]
        ]
        snapshot: new statement
        threshold: 99
        firstQuery: to :sqliteQuery statement
        secondQuery: to :sqliteQuery statement
        expects.be: 'equal? @[statement snapshot]
        expects.be: 'equal? @[firstQuery\params [18]]
        expects.be: 'equal? @[secondQuery\params [18]]
        expects.be: 'equal? @[firstQuery\text secondQuery\text]
    ]

    it "rejects dictionaries without the query fields" [
        failure: try [ignored: to :sqliteQuery #[text: "SELECT 1" params: []]]
        expects.be: 'equal? @[type failure :error]
    ]
]


describe "SQLite execution adapter" [
    it "executes dictionaries and compiled queries with SQLite booleans" [
        db: open.sqlite ":memory:"
        failure: try [
            query db {CREATE TABLE users (id INTEGER, name TEXT, active INTEGER)}
            query db {INSERT INTO users VALUES (1, 'Ada', 1), (2, 'Bob', 0), (3, 'Cy', 1)}
            statement: sql [
                select [name]
                from users
                where [active = true]
                orderBy [id]
                limit 1
                offset 1
            ]
            compiled: to :sqliteQuery statement
            expects.be: 'equal? @[query.with: compiled\params db compiled\text [["Cy"]]]
            expects.be: 'equal? @[sqliteExecute db statement [["Cy"]]]
            expects.be: 'equal? @[sqliteExecute db compiled [["Cy"]]]
            expects.be: 'equal? @[compiled\params [1 1 1]]
            inactive: to :sqliteQuery sql [
                select [name] from users where [active = false]
            ]
            expects.be: 'equal? @[query.with: inactive\params db inactive\text [["Bob"]]]
            expects.be: 'equal? @[sqliteExecute db sql [
                select [name] from users where [name = {x' OR 1=1 --}]
            ] []]
            expects.be: 'equal? @[sqliteExecute db sql [
                select [id] from users orderBy [id]
            ] [["1"] ["2"] ["3"]]]
            executionError: try [ignored: sqliteExecute db sql [select [*] from missing]]
            expects.be: 'equal? @[type executionError :error]
            invalidError: try [ignored: sqliteExecute db "SELECT 1"]
            expects.be: 'equal? @[type invalidError :error]
            ; Failed queries leave the caller's connection usable.
            expects.be: 'equal? @[query db "SELECT 1" [["1"]]]
        ]
        close db
        unless null? failure [throw to :string failure]
    ]
]

describe "SELECT attributes" [
    it "compiles combined attributes and arithmetic parameters" [
        compiled: to :sqliteQuery sql [
            select.expressions.distinct.as: [total adjusted] [[count [*]] [+ amount 2]]
            from users where [id > 3]
        ]
        expects.be: 'equal? @[compiled\params [2 3]]
        expects.be: 'equal? @[compiled\text {SELECT DISTINCT
    COUNT(*) AS "total",
    ("amount" + ?) AS "adjusted"
FROM
    "users"
WHERE
    "id" > ?}]
    ]
    it "rejects malformed projections" [
        loop [
            [select.as: [] [id] from users]
            [select.as: [all] [*] from users]
            [select.expressions [[sum [*]]] from users]
            [select.expressions [[+ id]] from users]
            [select.distinct.distinct [id] from users]
        ] 'input [
            failure: try [ignored: sql input]
            expects.be: 'equal? @[type failure :error]
        ]
    ]
]

describe "Join compilation" [
    it "quotes qualified names and binds ON parameters before WHERE" [
        statement: sql [
            select [u.id]
            from.as: u users
            join.left.as: o orders [u.id = o.userId and o.active = true]
            where [u.id > 2]
        ]
        snapshot: new statement
        compiled: to :sqliteQuery statement
        expects.be: 'equal? @[compiled\params [1 2]]
        expects.be: 'equal? @[contains? compiled\text {LEFT JOIN
    "orders" AS "o"
ON
    ("u"."id" = "o"."userId" AND "o"."active" = ?)} true]
        expects.be: 'equal? @[statement snapshot]
    ]
    it "rejects incomplete and misplaced joins" [
        loop [
            [select [id] from users join orders]
            [select [id] from users join.left.right orders [id = id]]
            [select [id] from users where [id = 1] join orders [id = id]]
        ] 'input [
            failure: try [ignored: sql input]
            expects.be: 'equal? @[type failure :error]
        ]
    ]
]

describe "Arrow join conditions" [
    it "matches predicate blocks and stops at subsequent clauses" [
        arrow: to :sqliteQuery sql [
            select [u.id] from.as: u users
            join orders -> u.id = orders.userId and orders.active = true
            join.left details -> orders.id = details.orderId
            where [u.id > 1] orderBy [u.id] limit 2
        ]
        explicit: to :sqliteQuery sql [
            select [u.id] from.as: u users
            join orders [u.id = orders.userId and orders.active = true]
            join.left details [orders.id = details.orderId]
            where [u.id > 1] orderBy [u.id] limit 2
        ]
        expects.be: 'equal? @[arrow\text explicit\text]
        expects.be: 'equal? @[arrow\params explicit\params]
    ]
    it "requires a complete arrow predicate" [
        loop [
            [select [id] from users join orders ->]
            [select [id] from users join orders []]
            [select [id] from users join orders -> [users.id = orders.userId]]
            [select [id] from users join orders on [users.id = orders.userId]]
            [select [id] from users join orders -> where [id = 1]]
            [select [id] from users join orders -> id =]
        ] 'input [
            failure: try [ignored: sql input]
            expects.be: 'equal? @[type failure :error]
        ]
    ]
]
