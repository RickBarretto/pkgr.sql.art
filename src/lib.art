import {tabular}!

; SQL blocks are parsed as data; only parenthesized expressions execute.

_sqlFail: $[message] -> throw message

_sqlText: $[value] -> to :string value

; Paths are stored as SQL components; Arturo does not evaluate identifier tokens.
_sqlIdentifierText: $[value] [
    ; Block serialization preserves custom type names; direct conversion yields "object".
    if :type = type value [
        return replace replace to :string @[value] "[:" "" "]" ""
    ]
    if contains? [:path :pathliteral] type value [
        return join.with:"." map to :block value 'part -> to :string part
    ]
    to :string value
]

_sqlKeywords: [
    select from join where orderBy limit offset
    and or is not null true false asc desc
    count sum avg min max on
]

; Bare words and paths may name ordinary identifiers. Explicit forms can name keywords.
_sqlCheckedName: $[value] [
    unless contains? [:word :literal :path :pathliteral :string :type] type value -> _sqlFail "Expected SQL identifier"
    if contains? [:word :path] type value [
        parts: (:path = type value) ? [to :block value] [@[value]]
        loop parts 'part [
            if contains? _sqlKeywords to :word part -> _sqlFail "Keyword identifiers require literals"
        ]
    ]
    _sqlIdentifierText value
]

_sqlIdentifier: $[value] -> #[kind: "identifier" value: _sqlCheckedName value]

_sqlValue: $[value] [
    if :inline = type value [
        results: @[do to :block value]
        if 1 <> size results -> _sqlFail "SQL expression must return one value"
        value: first results
    ]
    if contains? [:integer :floating :string :logical :null] type value -> return #[kind: "value" value: value]
    _sqlFail "SQL requires a scalar value"
]

; In expression contexts, strings are bound values; types and explicit names are identifiers.
_sqlOperand: $[token] [
    if contains? [:literal :path :pathliteral :type] type token -> return _sqlIdentifier token
    if :word = type token [
        spelling: to :string token
        if spelling = "true" -> return _sqlValue true
        if spelling = "false" -> return _sqlValue false
        if spelling = "null" -> _sqlFail "Use is null or is not null"
        if contains? spelling "*" -> _sqlFail "Wildcard is not a predicate operand"
        return _sqlIdentifier token
    ]
    _sqlValue token
]

_sqlPeek: $[state] [
    if state\position >= size state\tokens -> return ""
    token: get state\tokens state\position
    unless contains? [:word :symbol] type token -> return ""
    to :string token
]

_sqlTake: $[state] [
    if state\position >= size state\tokens -> _sqlFail "Unexpected end of SQL block"
    token: get state\tokens state\position
    state\position: state\position + 1
    token
]

_sqlReadName: $[state] [
    token: _sqlTake state
    _sqlCheckedName token
]

_sqlReference: $[state] -> _sqlTake state

_sqlRelation: $[state isJoin] [
    result: #[table: "" alias: null type: "INNER"]
    seen: []
    while [state\position < size state\tokens] [
        token: get state\tokens state\position
        unless contains? [:attribute :attributelabel] type token -> break
        name: to :string _sqlTake state
        if contains? seen name -> _sqlFail "Duplicate relation attribute"
        seen: append seen name
        (name = "as") ? [
            unless :attributelabel = type token -> _sqlFail "Alias requires a value"
            alias: _sqlTake state
            unless contains? [:word :literal :path :pathliteral :string :type] type alias -> _sqlFail "Expected alias"
            result\alias: _sqlCheckedName alias
        ] [
            unless and? isJoin contains? ["inner" "left" "right" "full"] name -> _sqlFail "Unknown relation attribute"
            unless :attribute = type token -> _sqlFail "Join type is a flag"
            if (size seen) > 1 [
                loop ["inner" "left" "right" "full"] 'other [
                    if and? other <> name contains? seen other -> _sqlFail "Conflicting join types"
                ]
            ]
            result\type: upper name
        ]
    ]
    result\table: _sqlReadName state
    if contains? result\table "*" -> _sqlFail "Invalid table wildcard"
    result
]

_sqlAtom: $[state] [
    head: _sqlPeek state
    if contains? ["and" "or"] head [
        ignored: _sqlTake state
        left: _sqlAtom state
        return #[kind: "boolean" operator: upper head left: left right: _sqlAtom state]
    ]
    if head = "not" [
        ignored: _sqlTake state
        return #[kind: "negation" argument: _sqlAtom state]
    ]
    if head = "exists" [
        ignored: _sqlTake state
        if "query" <> _sqlText _sqlTake state -> _sqlFail "EXISTS requires query"
        return #[kind: "exists" argument: #[kind: "subquery" query: _sqlBuild _sqlBody state]]
    ]
    token: get state\tokens state\position
    if :block = type token [
        following: state\position + 1
        scalarGroup: false
        if following < size state\tokens [
            nextToken: get state\tokens following
            if contains? [:word :symbol] type nextToken [
                scalarGroup: contains? ["=" "<>" "!=" "!" "<" "<=" "=<" ">" ">=" "is" "in" "between" "like" "+" "-" "*" "/"] to :string nextToken
            ]
        ]
        unless scalarGroup [ignored: _sqlTake state return _sqlPredicate token]
    ]
    left: _sqlExpression state
    operator: _sqlText _sqlTake state
    if operator = "!" [
        if "=" <> _sqlText _sqlTake state -> _sqlFail "Expected = after !"
        operator: "<>"
    ]
    if operator = "is" [
        negate: false
        if "not" = _sqlPeek state [
            ignored: _sqlTake state
            negate: true
        ]
        if "null" <> _sqlText _sqlTake state -> _sqlFail "Expected null after is"
        return #[kind: "null" left: left negate: negate]
    ]
    if contains? ["in" "between"] operator [
        values: _sqlTake state
        unless :block = type values -> _sqlFail "Expected value list"
        if empty? values -> _sqlFail "Empty predicate value list"
        if and? operator = "between" 2 <> size values -> _sqlFail "BETWEEN requires two values"
        return #[kind: operator left: left arguments: map values 'value -> _sqlExpressionOperand value]
    ]
    if operator = "like" -> return #[kind: "comparison" left: left operator: "LIKE" right: _sqlExpression state]
    unless contains? ["=" "<>" "!=" "<" "<=" "=<" ">" ">="] operator -> _sqlFail "Unsupported SQL comparison"
    if operator = "!=" -> operator: "<>"
    if operator = "=<" -> operator: "<="
    right: _sqlExpression state
    if left\kind = "value" -> if null? left\value -> _sqlFail "Use is null or is not null"
    if right\kind = "value" -> if null? right\value -> _sqlFail "Use is null or is not null"
    #[kind: "comparison" left: left operator: operator right: right]
]

_sqlAnd: $[state] [
    node: _sqlAtom state
    while ["and" = _sqlPeek state] [
        ignored: _sqlTake state
        node: #[kind: "boolean" operator: "AND" left: node right: _sqlAtom state]
    ]
    node
]

_sqlPredicate: $[tokens] [
    state: #[tokens: tokens position: 0]
    node: _sqlAnd state
    while ["or" = _sqlPeek state] [
        ignored: _sqlTake state
        node: #[kind: "boolean" operator: "OR" left: node right: _sqlAnd state]
    ]
    if state\position <> size tokens -> _sqlFail "Unexpected predicate token"
    node
]

_sqlProjection: $[token] [
    if :inline = type token -> return _sqlValue token
    if and? :pathliteral <> type token "*" = _sqlIdentifierText token -> return #[kind: "wildcard"]
    unless :block = type token [
        if and? :literal = type token contains? _sqlIdentifierText token "*" -> return #[kind: "qualifiedWildcard" value: to :string token]
        return _sqlOperand token
    ]
    expressionState: #[tokens: token position: 0]
    normalized: []
    while [expressionState\position < size expressionState\tokens] [
        normalized: append normalized @[_sqlReference expressionState]
    ]
    token: normalized
    if empty? token -> _sqlFail "Empty SQL expression"
    operator: to :string first token
    if contains? ["+" "-" "*" "/"] operator [
        if 3 <> size token -> _sqlFail "Arithmetic requires two operands"
        return #[kind: "arithmetic" operator: operator left: _sqlProjection get token 1 right: _sqlProjection get token 2]
    ]
    unless contains? ["count" "sum" "avg" "min" "max"] operator -> _sqlFail "Unsupported SQL expression"
    if 2 <> size token -> _sqlFail "Aggregate requires one argument block"
    arguments: get token 1
    unless :block = type arguments -> _sqlFail "Expected aggregate argument block"
    if 1 <> size arguments -> _sqlFail "Aggregate requires one argument"
    argument: _sqlProjection first arguments
    if argument\kind = "qualifiedWildcard" -> _sqlFail "Invalid aggregate wildcard"
    if and? argument\kind = "wildcard" operator <> "count" -> _sqlFail "Only count accepts wildcard"
    #[kind: "aggregate" operator: upper operator argument: argument]
]

import ./{parser.art}!

; Freeze host computations before parsing, including arrow lookahead and nested bodies.
_sqlFreeze: $[tokens] [
    map tokens 'token [
        (:block = type token) ? [_sqlFreeze token] [
            (:inline = type token) ? [get _sqlValue token 'value] [token]
        ]
    ]
]

import ./{validation.art}!

sql: $[_sqlInput :block] -> _sqlValidate _sqlBuild _sqlFreeze _sqlInput

_sqlQuotePart: $[name] -> join @["\"" replace name "\"" "\"\"" "\""]

_sqlQuote: $[name] -> join.with:"." map split.by:"." name 'part [
    (part = "*") ? ["*"] [_sqlQuotePart part]
]

_sqlRender: $[node output] [
    ; These adapters exist only during rendering; native Arturo functions stay intact.
    _sqliteScalar: $[scalar sink] [
        rendered: _sqlRender scalar sink
        if scalar\kind = "value" [
            storage: case type scalar\value [
                :integer ["INTEGER"]
                :floating ["REAL"]
                :logical ["INTEGER"]
                any [null]
            ]
            unless null? storage -> return join @["CAST(" rendered " AS " storage ")"]
        ]
        rendered
    ]
    _sqliteComparable: $[scalar peer sink] [
        ; A column applies its own affinity; scalar expressions have no column affinity.
        (peer\kind = "identifier") ? [_sqlRender scalar sink] [_sqliteScalar scalar sink]
    ]
    case node\kind [
        "schemaValue" [
            value: node\value
            if null? value -> return "NULL"
            if :logical = type value -> return value ? ["1"] ["0"]
            if :string = type value -> return join @["'" replace value "'" "''" "'"]
            return to :string value
        ]
        "alias" -> return join @[_sqlRender node\argument output " AS " _sqlQuote node\value]
        "function" -> return join @[node\operator "(" join.with:", " map node\arguments 'argument -> _sqliteScalar argument output ")"]
        "subquery" -> return join @["(" _sqlCompileInto node\query output ")"]
        "quantified" -> _sqlFail "SQLite cannot compile ALL/ANY comparisons; use to :postgresQuery"
        "exists" -> return join @["EXISTS " _sqlRender node\argument output]
        "negation" -> return join @["NOT (" _sqlRender node\argument output ")"]
        "in" -> return join @[_sqlRender node\left output " IN (" join.with:", " map node\arguments 'argument -> _sqliteComparable argument node\left output ")"]
        "between" -> return join @[_sqlRender node\left output " BETWEEN " _sqliteComparable first node\arguments node\left output " AND " _sqliteComparable last node\arguments node\left output]
        "choose" [
            result: "CASE"
            loop node\branches 'branch [
                result: join @[result " WHEN " _sqlRender branch\predicate output " THEN " _sqliteScalar branch\value output]
            ]
            unless null? node\fallback -> result: join @[result " ELSE " _sqliteScalar node\fallback output]
            return append result " END"
        ]
        "wildcard" -> return "*"
        "qualifiedWildcard" -> return _sqlQuote node\value
        "aggregate" -> return join @[node\operator "(" _sqlRender node\argument output ")"]
        "arithmetic" [
            if or? node\left\kind = "wildcard" node\right\kind = "wildcard" -> _sqlFail "Wildcard arithmetic is invalid"
            return join @["(" _sqlRender node\left output " " node\operator " " _sqlRender node\right output ")"]
        ]
        "identifier" -> return _sqlQuote node\value
        "value" [
            ; Normalize booleans; preserve NULL even on runtimes that bind every value as text.
            value: node\value
            if :logical = type value -> value: value ? [1] [0]
            output\params: append output\params value
            if null? value -> return "NULLIF(?, 'null')"
            return "?"
        ]
        "null" [
            return join @[
                _sqlRender node\left output " IS " node\negate ? ["NOT NULL"] ["NULL"]
            ]
        ]
        "comparison" [
            return join @[
                _sqliteComparable node\left node\right output " " node\operator " " _sqliteComparable node\right node\left output
            ]
        ]
        "boolean" [
            return join @[
                "(" _sqlRender node\left output " " node\operator " " _sqlRender node\right output ")"
            ]
        ]
        any -> _sqlFail "Invalid SQL expression node"
    ]
]

_sqlCompileSelect: $[data] [
    unless :dictionary = type data -> _sqlFail "Expected SQL query dictionary"
    loop [kind columns table predicates ordering limit offset] 'field [
        unless key? data field -> _sqlFail "Incomplete SQL query dictionary"
    ]
    unless data\kind = "select" -> _sqlFail "Expected select query"
    output: #[text: "" params: []]
    columns: map data\columns 'column [
        (:dictionary = type column) ? [_sqlRender column output] [
            (column = "*") ? ["*"] [_sqlQuote column]
        ]
    ]
    ignoredAliases: @[
        if key? data 'aliases [
            index: 0
            loop data\aliases 'columnAlias [
                set columns index join @[get columns index " AS " _sqlQuote to :string columnAlias]
                index: index + 1
            ]
        ]
    ]
    selectPrefix: "SELECT"
    if and? key? data 'distinct data\distinct -> selectPrefix: "SELECT DISTINCT"
    output\text: join @[
        selectPrefix "\n    " join.with:",\n    " columns
        "\nFROM\n    " _sqlQuote data\table
    ]
    unless null? data\tableAlias -> output\text: join @[output\text " AS " _sqlQuotePart data\tableAlias]
    ignoredJoins: @[
        loop data\joins 'relation [
            output\text: join @[
                output\text "\n" relation\type " JOIN\n    " _sqlQuote relation\table
            ]
            unless null? relation\alias -> output\text: join @[output\text " AS " _sqlQuotePart relation\alias]
            unless relation\type = "CROSS" -> output\text: join @[output\text "\nON\n    " _sqlRender relation\predicate output]
        ]
    ]
    filters: map data\predicates 'predicate [_sqlRender predicate output]
    unless empty? filters -> output\text: join @[output\text "\nWHERE\n    " join.with:"\n    AND " filters]
    if key? data 'details [
        details: data\details
        unless empty? details\groups [
            if details\groupMode <> "" -> _sqlFail join @["SQLite cannot compile group." details\groupMode "; use to :postgresQuery or plain group"]
            output\text: join @[output\text "\nGROUP BY\n    " join.with:", " map details\groups 'name -> _sqlQuote name]
        ]
    ]
    if key? data 'details [
        filters: map data\details\having 'predicate -> _sqlRender predicate output
        unless empty? filters -> output\text: join @[output\text "\nHAVING\n    " join.with:"\n    AND " filters]
    ]
    orders: map data\ordering 'order [
        join @[_sqlQuote order\column " " upper order\direction]
    ]
    unless empty? orders -> output\text: join @[output\text "\nORDER BY\n    " join.with:",\n    " orders]
    schema: false
    if key? data 'details -> schema: key? data\details 'schema
    unless null? data\limit [
        output\text: join @[output\text "\nLIMIT\n    " schema ? [to :string data\limit] ["?"]]
        unless schema -> output\params: append output\params data\limit
    ]
    unless null? data\offset [
        output\text: join @[output\text "\nOFFSET\n    " schema ? [to :string data\offset] ["?"]]
        unless schema -> output\params: append output\params data\offset
    ]
    output
]

import ./{compiler.art}!

; Dictionary conversion matches constructor arguments by field name.

define :sqliteQuery [
    init: method [kind columns table predicates ordering limit offset distinct aliases tableAlias joins details] [
        compiled: _sqlCompile #[
            details: details
            tableAlias: tableAlias
            joins: (null? joins) ? [[]] [joins]
            distinct: distinct
            aliases: aliases
            kind: kind
            columns: columns
            table: table
            predicates: predicates
            ordering: ordering
            limit: limit
            offset: offset
        ]
        this\text: compiled\text
        this\params: compiled\params
    ]
]

import ./{postgres.art}!

define :postgresQuery [
    init: method [kind columns table predicates ordering limit offset distinct aliases tableAlias joins details] [
        compiled: _sqlCompilePostgres #[
            kind: kind columns: columns table: table tableAlias: tableAlias joins: joins
            predicates: predicates ordering: ordering limit: limit offset: offset
            distinct: distinct aliases: aliases details: details
        ]
        this\text: compiled\text
        this\params: compiled\params
        this\statements: compiled\statements
    ]
]

; The caller owns the connection and closes it after use.

sqliteExecute: $[db :database statement] [
    if :dictionary = type statement -> statement: to :sqliteQuery statement
    unless :sqliteQuery = type statement -> _sqlFail "Expected SQL query dictionary or sqliteQuery"
    results: @[query.with: statement\params db statement\text]
    (empty? results) ? [[]] [first results]
]

; Return terminal-ready text; keep execution results available via sqliteExecute.

sqliteTable: function [db :database statement] [
    ;; options: [
    ;;     header: :block « optional column labels
    ;; ]
    headers: attr 'header
    rows: sqliteExecute db statement
    ; Tabular 0.2.0 requires at least one row to calculate column widths.
    if empty? rows -> return "No rows."
    unless null? headers [
        if (size headers) <> size first rows -> _sqlFail "Header count must match query columns"
        return tabular.header: headers rows
    ]
    tabular rows
]
