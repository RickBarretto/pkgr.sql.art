import {tabular}!

; SQL blocks are parsed as data; only parenthesized expressions execute.

_sqlFail: $[message] -> throw message

_sqlText: $[value] -> to :string value

_sqlIdentifier: $[value] -> #[kind: "identifier" value: to :string value]

_sqlValue: $[value] [
    if :inline = type value [
        results: @[do to :block value]
        if 1 <> size results [_sqlFail "SQL expression must return one value"]
        value: first results
    ]
    if contains? [:integer :floating :string :logical] type value [return #[kind: "value" value: value]]
    _sqlFail "SQL requires a scalar value"
]

_sqlOperand: $[token] [
    if :word = type token [
        spelling: to :string token
        if spelling = "true" [return _sqlValue true]
        if spelling = "false" [return _sqlValue false]
        if spelling = "null" [_sqlFail "Use is null or is not null"]
        if contains? spelling "*" [_sqlFail "Wildcard is not a predicate operand"]
        return _sqlIdentifier token
    ]
    _sqlValue token
]

_sqlPeek: $[state] [
    if state\position >= size state\tokens [return ""]
    to :string get state\tokens state\position
]

_sqlTake: $[state] [
    if state\position >= size state\tokens [_sqlFail "Unexpected end of SQL block"]
    token: get state\tokens state\position
    state\position: state\position + 1
    token
]

_sqlReadName: $[state] [
    token: _sqlTake state
    unless :word = type token [_sqlFail "Expected identifier"]
    name: to :string token
    while [state\position < size state\tokens] [
        nextToken: get state\tokens state\position
        unless :attribute = type nextToken [break]
        part: to :string _sqlTake state
        if empty? part [
            if "*" <> _sqlText _sqlTake state [_sqlFail "Expected qualified wildcard"]
            part: "*"
        ]
        name: join @[name "." part]
    ]
    name
]

_sqlReference: $[state] [
    if :word = type get state\tokens state\position [
        return to :word _sqlReadName state
    ]
    _sqlTake state
]

_sqlRelation: $[state isJoin] [
    result: #[table: "" alias: null type: "INNER"]
    seen: []
    while [state\position < size state\tokens] [
        token: get state\tokens state\position
        unless contains? [:attribute :attributelabel] type token [break]
        name: to :string _sqlTake state
        if contains? seen name [_sqlFail "Duplicate relation attribute"]
        seen: append seen name
        (name = "as") ? [
            unless :attributelabel = type token [_sqlFail "Alias requires a value"]
            alias: _sqlTake state
            unless :word = type alias [_sqlFail "Expected alias"]
            result\alias: to :string alias
        ] [
            unless and? isJoin contains? ["inner" "left" "right"] name [
                _sqlFail "Unknown relation attribute"
            ]
            unless :attribute = type token [_sqlFail "Join type is a flag"]
            if (size seen) > 1 [
                loop ["inner" "left" "right"] 'other [
                    if and? other <> name contains? seen other [_sqlFail "Conflicting join types"]
                ]
            ]
            result\type: upper name
        ]
    ]
    result\table: _sqlReadName state
    if contains? result\table "*" [_sqlFail "Invalid table wildcard"]
    result
]

_sqlAtom: $[state] [
    token: _sqlReference state
    if :block = type token [return _sqlPredicate token]
    left: _sqlOperand token
    operator: _sqlText _sqlTake state
    if operator = "!" [
        if "=" <> _sqlText _sqlTake state [_sqlFail "Expected = after !"]
        operator: "<>"
    ]
    if operator = "is" [
        negate: false
        if "not" = _sqlPeek state [
            ignored: _sqlTake state
            negate: true
        ]
        if "null" <> _sqlText _sqlTake state [_sqlFail "Expected null after is"]
        return #[kind: "null" left: left negate: negate]
    ]
    unless contains? ["=" "<>" "!=" "<" "<=" ">" ">="] operator [
        _sqlFail "Unsupported SQL comparison"
    ]
    if operator = "!=" [operator: "<>"]
    right: _sqlOperand _sqlReference state
    #[kind: "comparison" left: left operator: operator right: right]
]

_sqlAnd: $[state] [
    node: _sqlAtom state
    while ["and" = _sqlPeek state] [
        ignored: _sqlTake state
        node: #[kind: "boolean" operator: "AND" left: node right: _sqlAtom state]
    ]
    node
]

_sqlPredicate: $[tokens] [
    state: #[tokens: tokens position: 0]
    node: _sqlAnd state
    while ["or" = _sqlPeek state] [
        ignored: _sqlTake state
        node: #[kind: "boolean" operator: "OR" left: node right: _sqlAnd state]
    ]
    if state\position <> size tokens [_sqlFail "Unexpected predicate token"]
    node
]

_sqlProjection: $[token] [
    if :inline = type token [return _sqlValue token]
    if "*" = to :string token [return #[kind: "wildcard"]]
    unless :block = type token [
        if and? :word = type token contains? to :string token "*" [
            return #[kind: "qualifiedWildcard" value: to :string token]
        ]
        return _sqlOperand token
    ]
    expressionState: #[tokens: token position: 0]
    normalized: []
    while [expressionState\position < size expressionState\tokens] [
        normalized: append normalized @[_sqlReference expressionState]
    ]
    token: normalized
    if empty? token [_sqlFail "Empty SQL expression"]
    operator: to :string first token
    if contains? ["+" "-" "*" "/"] operator [
        if 3 <> size token [_sqlFail "Arithmetic requires two operands"]
        return #[kind: "arithmetic" operator: operator left: _sqlProjection get token 1 right: _sqlProjection get token 2]
    ]
    unless contains? ["count" "sum" "avg" "min" "max"] operator [
        _sqlFail "Unsupported SQL expression"
    ]
    if 2 <> size token [_sqlFail "Aggregate requires one argument block"]
    arguments: get token 1
    unless :block = type arguments [_sqlFail "Expected aggregate argument block"]
    if 1 <> size arguments [_sqlFail "Aggregate requires one argument"]
    argument: _sqlProjection first arguments
    if argument\kind = "qualifiedWildcard" [_sqlFail "Invalid aggregate wildcard"]
    if and? argument\kind = "wildcard" operator <> "count" [_sqlFail "Only count accepts wildcard"]
    #[kind: "aggregate" operator: upper operator argument: argument]
]

sql: $[_sqlInput] [
    _sqlState: #[tokens: _sqlInput position: 0]
    _sqlQuery: #[
        kind: "select"
        columns: []
        table: ""
        predicates: []
        ordering: []
        limit: null
        offset: null
    ]
    if "select" <> _sqlText _sqlTake _sqlState [_sqlFail "Expected select"]
    _sqlQuery\distinct: false
    _sqlQuery\aliases: []
    _sqlExpressions: false
    _sqlSeen: []
    while [contains? [:attribute :attributelabel] type get _sqlInput _sqlState\position] [
        _sqlAttribute: _sqlTake _sqlState
        _sqlName: to :string _sqlAttribute
        if contains? _sqlSeen _sqlName [_sqlFail "Duplicate SELECT attribute"]
        _sqlSeen: append _sqlSeen _sqlName
        case _sqlName [
            "distinct" [
                unless :attribute = type _sqlAttribute [_sqlFail "distinct is a flag"]
                _sqlQuery\distinct: true
            ]
            "expressions" [
                unless :attribute = type _sqlAttribute [_sqlFail "expressions is a flag"]
                _sqlExpressions: true
            ]
            "as" [
                unless :attributelabel = type _sqlAttribute [_sqlFail "as requires aliases"]
                _sqlQuery\aliases: _sqlTake _sqlState
                unless :block = type _sqlQuery\aliases [_sqlFail "Expected alias block"]
            ]
            any [_sqlFail "Unknown SELECT attribute"]
        ]
    ]
    _sqlColumns: _sqlTake _sqlState
    unless :block = type _sqlColumns [_sqlFail "Expected column block"]
    if empty? _sqlColumns [_sqlFail "Select requires columns"]
    _sqlColumnState: #[tokens: _sqlColumns position: 0]
    _sqlNormalized: []
    while [_sqlColumnState\position < size _sqlColumns] [
        _sqlNormalized: append _sqlNormalized @[_sqlReference _sqlColumnState]
    ]
    _sqlColumns: _sqlNormalized
    loop _sqlColumns '_sqlColumn [
        if _sqlExpressions [
            _sqlQuery\columns: append _sqlQuery\columns _sqlProjection _sqlColumn
        ]
        unless _sqlExpressions [
            unless or? :word = type _sqlColumn "*" = to :string _sqlColumn [_sqlFail "Invalid column"]
            _sqlQuery\columns: append _sqlQuery\columns to :string _sqlColumn
        ]
    ]
    if contains? _sqlSeen "as" [
        if (size _sqlQuery\aliases) <> size _sqlQuery\columns [
            _sqlFail "Alias count must match projections"
        ]
        loop _sqlQuery\aliases '_sqlAlias [
            unless :word = type _sqlAlias [_sqlFail "Expected alias identifier"]
        ]
        loop _sqlColumns '_sqlColumn [
            if and? :block <> type _sqlColumn contains? to :string _sqlColumn "*" [
                _sqlFail "Cannot alias wildcard"
            ]
        ]
    ]
    if "from" <> _sqlText _sqlTake _sqlState [_sqlFail "Expected from"]
    _sqlFrom: _sqlRelation _sqlState false
    _sqlQuery\table: _sqlFrom\table
    _sqlQuery\tableAlias: _sqlFrom\alias
    _sqlQuery\joins: []
    while ["join" = _sqlPeek _sqlState] [
        ignored: _sqlTake _sqlState
        _sqlJoin: _sqlRelation _sqlState true
        _sqlArgument: _sqlTake _sqlState
        (:block = type _sqlArgument) ? [
            _sqlCondition: _sqlArgument
        ] [
            if "->" <> _sqlText _sqlArgument [
                _sqlFail "Join requires a predicate block or -> expression"
            ]
            if _sqlState\position < size _sqlInput [
                if :block = type get _sqlInput _sqlState\position [_sqlFail "Use join table [predicate] without ->"]
            ]
            _sqlCondition: []
            while [_sqlState\position < size _sqlInput] [
                _sqlNext: get _sqlInput _sqlState\position
                if and? :word = type _sqlNext contains? ["join" "where" "orderBy" "limit" "offset"] to :string _sqlNext [
                    break
                ]
                _sqlCondition: append _sqlCondition @[_sqlTake _sqlState]
            ]
        ]
        _sqlJoin\predicate: _sqlPredicate _sqlCondition
        _sqlQuery\joins: append _sqlQuery\joins _sqlJoin
    ]
    _sqlStage: 0
    while [_sqlState\position < size _sqlInput] [
        _sqlClause: _sqlText _sqlTake _sqlState
        case _sqlClause [
            "where" [
                if _sqlStage > 0 [_sqlFail "where must precede ordering and pagination"]
                _sqlQuery\predicates: append _sqlQuery\predicates _sqlPredicate _sqlTake _sqlState
            ]
            "orderBy" [
                if _sqlStage > 0 [_sqlFail "Duplicate or misplaced orderBy"]
                _sqlStage: 1
                _sqlOrderTokens: _sqlTake _sqlState
                unless :block = type _sqlOrderTokens [_sqlFail "Expected ordering block"]
                if empty? _sqlOrderTokens [_sqlFail "Empty ordering block"]
                _sqlOrder: #[tokens: _sqlOrderTokens position: 0]
                while [_sqlOrder\position < size _sqlOrder\tokens] [
                    _sqlName: to :word _sqlReadName _sqlOrder
                    unless :word = type _sqlName [_sqlFail "Expected ordering column"]
                    _sqlDirection: "asc"
                    if contains? ["asc" "desc"] _sqlPeek _sqlOrder [
                        _sqlDirection: _sqlText _sqlTake _sqlOrder
                    ]
                    _sqlQuery\ordering: append _sqlQuery\ordering #[
                        column: to :string _sqlName
                        direction: _sqlDirection
                    ]
                ]
            ]
            "limit" [
                if _sqlStage > 1 [_sqlFail "Duplicate or misplaced limit"]
                _sqlStage: 2
                _sqlQuery\limit: get _sqlValue _sqlTake _sqlState 'value
            ]
            "offset" [
                if _sqlStage <> 2 [_sqlFail "offset requires limit"]
                _sqlStage: 3
                _sqlQuery\offset: get _sqlValue _sqlTake _sqlState 'value
            ]
            any [_sqlFail "Unknown SQL clause"]
        ]
    ]
    loop @[_sqlQuery\limit _sqlQuery\offset] '_sqlPage [
        unless null? _sqlPage [
            unless :integer = type _sqlPage [_sqlFail "Pagination requires integers"]
            if _sqlPage < 0 [_sqlFail "Pagination cannot be negative"]
        ]
    ]
    _sqlQuery
]

_sqlQuotePart: $[name] -> join @["\"" replace name "\"" "\"\"" "\""]

_sqlQuote: $[name] -> join.with:"." map split.by:"." name 'part [
    (part = "*") ? ["*"] [_sqlQuotePart part]
]

_sqlRender: $[node output] [
    case node\kind [
        "wildcard" [return "*"]
        "qualifiedWildcard" [return _sqlQuote node\value]
        "aggregate" [return join @[node\operator "(" _sqlRender node\argument output ")"]]
        "arithmetic" [
            if or? node\left\kind = "wildcard" node\right\kind = "wildcard" [
                _sqlFail "Wildcard arithmetic is invalid"
            ]
            return join @["(" _sqlRender node\left output " " node\operator " " _sqlRender node\right output ")"]
        ]
        "identifier" [return _sqlQuote node\value]
        "value" [
            ; SQLite binds booleans as integers; Arturo otherwise binds them as text.
            value: node\value
            if :logical = type value [value: value ? [1] [0]]
            output\params: append output\params value
            return "?"
        ]
        "null" [
            return join @[
                _sqlRender node\left output " IS " node\negate ? ["NOT NULL"] ["NULL"]
            ]
        ]
        "comparison" [
            return join @[
                _sqlRender node\left output " " node\operator " " _sqlRender node\right output
            ]
        ]
        "boolean" [
            return join @[
                "(" _sqlRender node\left output " " node\operator " " _sqlRender node\right output ")"
            ]
        ]
        any [_sqlFail "Invalid SQL expression node"]
    ]
]

_sqlCompile: $[data] [
    unless :dictionary = type data [_sqlFail "Expected SQL query dictionary"]
    loop [kind columns table predicates ordering limit offset] 'field [
        unless key? data field [_sqlFail "Incomplete SQL query dictionary"]
    ]
    unless data\kind = "select" [_sqlFail "Expected select query"]
    output: #[text: "" params: []]
    columns: map data\columns 'column [
        (:dictionary = type column) ? [_sqlRender column output] [
            (column = "*") ? ["*"] [_sqlQuote column]
        ]
    ]
    ignoredAliases: @[
        if key? data 'aliases [
            index: 0
            loop data\aliases 'columnAlias [
                set columns index join @[get columns index " AS " _sqlQuote to :string columnAlias]
                index: index + 1
            ]
        ]
    ]
    selectPrefix: "SELECT"
    if and? key? data 'distinct data\distinct [selectPrefix: "SELECT DISTINCT"]
    output\text: join @[
        selectPrefix "\n    " join.with:",\n    " columns
        "\nFROM\n    " _sqlQuote data\table
    ]
    unless null? data\tableAlias [
        output\text: join @[output\text " AS " _sqlQuotePart data\tableAlias]
    ]
    ignoredJoins: @[
        loop data\joins 'relation [
            output\text: join @[
                output\text "\n" relation\type " JOIN\n    " _sqlQuote relation\table
            ]
            unless null? relation\alias [
                output\text: join @[output\text " AS " _sqlQuotePart relation\alias]
            ]
            output\text: join @[output\text "\nON\n    " _sqlRender relation\predicate output]
        ]
    ]
    filters: map data\predicates 'predicate [_sqlRender predicate output]
    unless empty? filters [
        output\text: join @[output\text "\nWHERE\n    " join.with:"\n    AND " filters]
    ]
    orders: map data\ordering 'order [
        join @[_sqlQuote order\column " " upper order\direction]
    ]
    unless empty? orders [
        output\text: join @[output\text "\nORDER BY\n    " join.with:",\n    " orders]
    ]
    unless null? data\limit [
        output\text: append output\text "\nLIMIT\n    ?"
        output\params: append output\params data\limit
    ]
    unless null? data\offset [
        output\text: append output\text "\nOFFSET\n    ?"
        output\params: append output\params data\offset
    ]
    output
]

; Dictionary conversion matches constructor arguments by field name.

define :sqliteQuery [
    init: method [kind columns table predicates ordering limit offset distinct aliases tableAlias joins] [
        compiled: _sqlCompile #[
            tableAlias: tableAlias
            joins: (null? joins) ? [[]] [joins]
            distinct: distinct
            aliases: aliases
            kind: kind
            columns: columns
            table: table
            predicates: predicates
            ordering: ordering
            limit: limit
            offset: offset
        ]
        this\text: compiled\text
        this\params: compiled\params
    ]
]

; The caller owns the connection and closes it after use.

sqliteExecute: $[db :database statement] [
    if :dictionary = type statement [statement: to :sqliteQuery statement]
    unless :sqliteQuery = type statement [_sqlFail "Expected SQL query dictionary or sqliteQuery"]
    query.with: statement\params db statement\text
]

; Return terminal-ready text; keep execution results available via sqliteExecute.

sqliteTable: function [db :database statement] [
    ;; options: [
    ;;     header: :block « optional column labels
    ;; ]
    headers: attr 'header
    rows: sqliteExecute db statement
    ; Tabular 0.2.0 requires at least one row to calculate column widths.
    if empty? rows [return "No rows."]
    unless null? headers [
        if (size headers) <> size first rows [_sqlFail "Header count must match query columns"]
        return tabular.header: headers rows
    ]
    tabular rows
]
