sql [
    from :books
    select [genre publisherId]
    select.count "*"
    group.rollup [genre publisherId]
]

sql [
    from :books
    select [genre publisherId]
    select count "*"
    group.rollup [genre publisherId]
]

---
SELECT genre,
    publisherId,
    COUNT(*)
FROM books
GROUP BY ROLLUP (genre, publisherId);
