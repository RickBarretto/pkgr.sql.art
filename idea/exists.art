sql [
    select b\title
    from.as: b :books
    where -> exists [
        select id
        from :loans
        where -> loans\bookId = b\id
    ]
]

sql [
    select b\title
    from.as: b :books
    where [exists [
        select id
        from :loans
        where [loans\bookId = b\id]
    ]]
]

---
SELECT b.title
FROM books AS b
WHERE EXISTS (
    SELECT id
    FROM loans
    WHERE loans.bookId = b.id
);
