sql [
    with :recentBooks [
        select [id title]
        from :books
        where -> publishedYear >= 2020
    ]
    select title
    from :recentBooks
]

sql [
    with.as: :recentBooks [
        select [id title]
        from :books
        where -> publishedYear >= 2020
    ]
    select title
    from :recentBooks
]

---
WITH recentBooks AS (
    SELECT id, title
    FROM books
    WHERE publishedYear >= 2020
)
SELECT title
FROM recentBooks;
