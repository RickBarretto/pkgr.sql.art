sql [
    select [s\name parent\name]
    from.as: s :shelves
    join.left.as: parent :shelves -> s\parentId = parent\id
]

sql [
    select [s\name parent\name]
    from.as: s 'shelves
    join.left.as: parent 'shelves -> s\parentId = parent\id
]

---
SELECT s.name,
    parent.name
FROM shelves AS s
LEFT JOIN shelves AS parent
ON s.parentId = parent.id;
