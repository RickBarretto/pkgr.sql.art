sql [
    create.trigger.after.insert.on: :loans loanAdded [
        update :books
        set [available: false]
        where -> id = new\bookId
    ]
]

sql [
    trigger.create.after.insert.on: :loans loanAdded [
        update :books
        set [available: false]
        where -> id = new\bookId
    ]
]

---
CREATE TRIGGER loanAdded AFTER INSERT
ON loans
BEGIN UPDATE books
SET available = 0
WHERE id = NEW.bookId;
END;
