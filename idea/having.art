sql [
    select.expressions [genre [count *]]
    from :books
    groupBy genre
    having -> [count *] > 3
]

sql [
    select.expressions [genre [count *]]
    from :books
    groupBy genre
    having [[count *] > 3]
]

---
SELECT genre,
    COUNT(*)
FROM books
GROUP BY genre
HAVING COUNT(*) > 3;
