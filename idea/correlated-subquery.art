sql [
    select b\title
    from.as: b :books
    where -> pageCount > [
        select.expressions [avg peer\pageCount]
        from.as: peer :books
        where -> peer\genre = b\genre
    ]
]

sql [
    select b\title
    from.as: b :books
    where [pageCount > [
        select.expressions [avg peer\pageCount]
        from.as: peer :books
        where [peer\genre = b\genre]
    ]]
]

---
SELECT b.title
FROM books AS b
WHERE b.pageCount > (
    SELECT AVG(peer.pageCount)
    FROM books AS peer
    WHERE peer.genre = b.genre
);
