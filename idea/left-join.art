sql [
    select [b\title p\name]
    from.as: b :books
    join.left.as: p :publishers -> b\publisherId = p\id
]

sql [
    select [b\title p\name]
    from.as: b 'books
    join.left.as: p 'publishers -> b\publisherId = p\id
]

---
SELECT b.title,
    p.name
FROM books AS b
LEFT JOIN publishers AS p
ON b.publisherId = p.id;
