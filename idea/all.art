sql [
    from.as: 'b :books
    select 'b\title
    from :archive
    select 'pages
    where 'b\pages > all 'pages
]

sql [
    from.as: 'b 'books
    select 'b\title
    from 'archive
    select 'pages
    where 'b\pages > all 'pages
]

---
SELECT b.title
FROM Books AS b
WHERE b.pageCount > ALL (
    SELECT pageCount
    FROM Archive
);
