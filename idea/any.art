sql [
    select b\title
    from.as: b :books
    where -> pageCount > any [
        select pageCount
        from :archivedBooks
    ]
]

sql [
    select b\title
    from.as: b :books
    where [pageCount > any [
        select pageCount
        from :archivedBooks
    ]]
]

---
SELECT b.title
FROM books AS b
WHERE b.pageCount > ANY (
    SELECT pageCount
    FROM archivedBooks
);
