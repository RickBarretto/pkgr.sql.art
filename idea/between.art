sql [
    select title
    from :books
    where -> publishedYear between [2015 2020]
]
sql [
    select title
    from :books
    where -> publishedYear >= 2015 and publishedYear =< 2020
]

sql [
    select title
    from :books
    where [publishedYear between [2015 2020]]
]

---
SELECT title
FROM books
WHERE publishedYear BETWEEN 2015 AND 2020;

SELECT title
FROM books
WHERE publishedYear >= 2015 AND publishedYear <= 2020;
