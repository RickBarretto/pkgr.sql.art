import relative "../src/lib.art"!

; Run with: arturo examples/aggregates.art
; Each example checks its results against an in-memory SQLite database.
db: open.sqlite ":memory:"
failure: try [
    query db "CREATE TABLE orders (amount INTEGER)"
    query db {INSERT INTO orders VALUES (10), (20)}
    statement: sql [
        select.expressions.as: [total sumAmount average smallest largest] [[count [*]] [sum [amount]] [avg [amount]] [min [amount]] [max [amount]]] from orders
    ]
    compiled: to :sqliteQuery statement
    rows: sqliteExecute db compiled
    ensure -> rows = [["2" "30" "15.0" "10" "20"]]
    print compiled\text
    inspect rows
]
close db
unless null? failure [throw to :string failure]
print "aggregates: passed"
