import relative "../src/lib.art"!

; Execute a filtered query and render a terminal table; assertions check its rows.
db: open.sqlite ":memory:"

failure: try [
    query db "CREATE TABLE users (id INTEGER, name TEXT, age INTEGER, active INTEGER)"
    query db {INSERT INTO users VALUES (1, 'Ada', 30, 1), (2, 'Bob', 16, 1)}
    minimumAge: 18
    statement: sql [
        select [id name]
        from users
        where [age >= @minimumAge and active = true]
        orderBy [name]
    ]
    compiled: to :sqliteQuery statement
    rows: sql.query: db compiled
    ensure -> rows = [["1" "Ada"]]
    print tabular.header: ["ID" "Name"] rows
]

close db

unless null? failure 
    -> throw to :string failure

print "sqlite: passed"
