import relative "../src/lib.art"!

; Run with: arturo examples/aliases.art
; Each example checks its results against an in-memory SQLite database.
db: open.sqlite ":memory:"
failure: try [
    query db "CREATE TABLE users (id INTEGER, name TEXT)"
    query db {INSERT INTO users VALUES (1, 'Ada')}
    statement: sql [
        select.as: [userId userName] [id name] from users
    ]
    compiled: to :sqliteQuery statement
    rows: sqliteExecute db compiled
    ensure -> rows = [["1" "Ada"]]
    print compiled\text
    inspect rows
]
close db
unless null? failure [throw to :string failure]
print "aliases: passed"
