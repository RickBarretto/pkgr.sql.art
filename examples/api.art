import {src/lib.art}!

db: open.sqlite ":memory:"
failure: try [
    ignored: sql.query: db [create :books [
        column.primary 'id :integer
        column 'title :string
        column 'publishedYear :integer
        column 'available :logical
    ]]
    ignored: sql.query: db [insert :books [
        columns [id title publishedYear available]
        row [1 "River Atlas" 2024 true]
        row [2 "Quiet Maps" 2021 false]
    ]]
    minimumYear: 2020
    statement: sql [
        from :books
        select [title publishedYear]
        where -> and publishedYear >= (minimumYear) available = true
        order.desc 'publishedYear
        limit 10
    ]
    ensure -> (sqliteExecute db statement) = [["River Atlas" "2024"]]
    composed: sql [
        from :books
        select coalesce [[nullif title ""] "Untitled"]
        select.as: 'nextYear + publishedYear 1
        where [publishedYear + 1 >= 2025]
    ]
    ensure -> (sqliteExecute db composed) = [["River Atlas" "2025"]]
    correlated: sql [
        from.as: b :books select 'b\title
        where [exists query [from.as: peer :books select 'peer\id where [peer\id = b\id]]]
        order 'b\id
    ]
    ensure -> (sqliteExecute db correlated) = [["River Atlas"] ["Quiet Maps"]]
    combined: sql [combine.union [
        sql [from :books select 'title order.desc 'publishedYear limit 1]
        sql [with :archived [from :books select 'title where [available = false]] from :archived select 'title]
    ]]
    ensure -> (sqliteExecute db combined) = [["Quiet Maps"] ["River Atlas"]]
    print tabular.header: ["Title" "Year"] sql.query: db statement
]
close db
unless null? failure -> throw to :string failure
