import relative "../src/lib.art"!

minimumAge: 18
statement: sql [
    select [id name email]
    from users
    where [age >= (minimumAge) and active = true]
    orderBy [name asc]
    limit 20
]

compiled: to :sqliteQuery statement
print compiled\text
inspect compiled\params

ensure -> compiled\params = [18 1 20]
ensure -> contains? compiled\text "SELECT"
print "select: passed"
